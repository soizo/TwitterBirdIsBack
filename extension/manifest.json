{
  "manifest_version": 3,
  "name": "Twitter Bird Is Back",
  "version": "0.1.0",
  "description": "Replace X brand logos with the blue bird on x.com.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*"],
      "js": ["locales.js", "content.js", "classic-ui.js", "title.js"],
      "css": ["classic-ui.css"],
      "run_at": "document_start"
    }
  ]
}
